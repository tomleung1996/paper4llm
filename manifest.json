{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extensionName__",
  "short_name": "__MSG_extensionShortName__",
  "version": "1.2.0",
  "description": "__MSG_extensionDescription__",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://www.sciencedirect.com/science/article/pii/*",
    "https://onlinelibrary.wiley.com/doi/*",
    "https://*.onlinelibrary.wiley.com/doi/*",
    "https://www.nature.com/articles/*",
    "https://nature.com/articles/*",
    "https://*.nature.com/articles/*",
    "https://link.springer.com/article/*",
    "https://www.science.org/doi/*",
    "https://science.org/doi/*",
    "https://www.mdpi.com/*",
    "https://mdpi.com/*",
    "https://www.tandfonline.com/doi/*",
    "https://tandfonline.com/doi/*",
    "https://www.frontiersin.org/*",
    "https://frontiersin.org/*",
    "https://academic.oup.com/*/article/*",
    "https://direct.mit.edu/*/article/*",
    "https://ieeexplore.ieee.org/document/*",
    "https://www.ovid.com/jnls/*",
    "https://*.lww.com/*",
    "https://journals.sagepub.com/doi/*",
    "https://sage.cnpereading.com/doi/*"
  ],
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.sciencedirect.com/science/article/pii/*",
        "https://onlinelibrary.wiley.com/doi/*",
        "https://*.onlinelibrary.wiley.com/doi/*",
        "https://www.nature.com/articles/*",
        "https://nature.com/articles/*",
        "https://*.nature.com/articles/*",
        "https://link.springer.com/article/*",
        "https://www.science.org/doi/*",
        "https://science.org/doi/*",
        "https://www.mdpi.com/*",
        "https://mdpi.com/*",
        "https://www.tandfonline.com/doi/*",
        "https://tandfonline.com/doi/*",
        "https://www.frontiersin.org/*",
        "https://frontiersin.org/*",
        "https://academic.oup.com/*/article/*",
        "https://direct.mit.edu/*/article/*",
        "https://ieeexplore.ieee.org/document/*",
        "https://www.ovid.com/jnls/*",
        "https://*.lww.com/*",
        "https://journals.sagepub.com/doi/*",
        "https://sage.cnpereading.com/doi/*"
      ],
      "js": [
        "src/i18n.js",
        "src/core.js",
        "src/sciencedirect.js",
        "src/wiley.js",
        "src/springernature.js",
        "src/science.js",
        "src/publisher-platforms.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
